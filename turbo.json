{
  "$schema": "https://turborepo.org/schema.json",
  "baseBranch": "origin/main",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@swirly/examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["../../examples/*.txt"],
      "outputs": [
        "../../examples/*.svg",
        "../../examples/*.png",
        "../../examples.md"
      ]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "@swirly/tests#test": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "package.json",
        "src/**",
        "fixtures/**",
        "golden/**",
        "../../examples/*.txt"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "inputs": ["dist/**"],
      "outputs": []
    }
  }
}
